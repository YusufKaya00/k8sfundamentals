{
  "id": null,
  "uid": "rs-messaging",
  "title": "ResilienceStream - 02. Messaging, Kafka Lag & RabbitMQ DLQ",
  "description": "Real-time monitoring for Kafka event streaming (orders.events -> analytics-consumer -> Cassandra) and RabbitMQ task queues (payments -> payment-worker -> Postgres + payments.dlq).",
  "tags": [
    "resiliencestream",
    "kafka",
    "rabbitmq",
    "cassandra",
    "chaos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Kafka Offsets (Produced vs Consumed)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(rs_kafka_topic_end_offset) or sum(rs_orders_created_total)",
          "legendFormat": "Produced Offset"
        },
        {
          "expr": "max(rs_kafka_group_committed_offset) or sum(rs_kafka_events_consumed_total)",
          "legendFormat": "Consumed Offset"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Kafka Consumer Lag (orders.events)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(rs_kafka_consumer_lag) or vector(0)",
          "legendFormat": "Kafka Lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "RabbitMQ Active Consumers & Queue Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(rs_rabbitmq_queue_consumers{queue=\"payments\"}) or vector(0)",
          "legendFormat": "Active Consumers"
        },
        {
          "expr": "max(rs_rabbitmq_queue_messages_ready{queue=\"payments\"}) or vector(0)",
          "legendFormat": "Ready (payments)"
        },
        {
          "expr": "max(rs_rabbitmq_queue_messages_ready{queue=\"payments.dlq\"}) or vector(0)",
          "legendFormat": "DLQ (payments.dlq)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "Payment Worker Processed Totals (success / retry / dlq)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rs_rabbitmq_messages_processed_total)",
          "legendFormat": "{{ result }}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "title": "Kafka Consumer Lag & Topic Offsets Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(rs_kafka_consumer_lag) or vector(0)",
          "legendFormat": "Kafka Consumer Lag (messages)"
        },
        {
          "expr": "sum(rate(rs_kafka_events_consumed_total[1m])) or vector(0)",
          "legendFormat": "Kafka Consumed/s"
        }
      ]
    },
    {
      "id": 6,
      "title": "RabbitMQ Queue Depth (payments vs payments.dlq) & Active Consumers",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(rs_rabbitmq_queue_messages_ready{queue=\"payments\"}) or vector(0)",
          "legendFormat": "Queue Depth (payments)"
        },
        {
          "expr": "max(rs_rabbitmq_queue_messages_ready{queue=\"payments.dlq\"}) or vector(0)",
          "legendFormat": "DLQ Messages (payments.dlq)"
        },
        {
          "expr": "max(rs_rabbitmq_queue_consumers{queue=\"payments\"}) or vector(0)",
          "legendFormat": "Active Consumers (payment-worker)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cassandra Write Latency & Data Layer Latency (p95 / Avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(rs_dependency_latency_seconds_bucket[1m])))",
          "legendFormat": "{{ dependency }} p95 latency"
        },
        {
          "expr": "sum by (dependency) (rate(rs_dependency_latency_seconds_sum[1m])) / clamp_min(sum by (dependency) (rate(rs_dependency_latency_seconds_count[1m])), 0.0001)",
          "legendFormat": "{{ dependency }} avg latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ]
}
