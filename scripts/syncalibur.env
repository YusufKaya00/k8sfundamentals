# ==============================================================================
# Syncalibur Configuration (syncalibur.env)
# ==============================================================================
# Enter the directory path you want to watch in SYNCALIBUR_REPO_PATH below,
# then run:
#   ./scripts/syncalibur.sh install
#
# Examples for all operating systems:
#   Linux   : SYNCALIBUR_REPO_PATH="/home/ysf/k8sfundamentals"
#   macOS   : SYNCALIBUR_REPO_PATH="/Users/username/projects/my-repo"
#   Windows : SYNCALIBUR_REPO_PATH="C:/Users/username/projects/my-repo"
#   Relative: SYNCALIBUR_REPO_PATH=".."   (watches the repo containing scripts/)
# ==============================================================================

# Path to the git repository (or a specific subfolder inside a repo) to watch:
SYNCALIBUR_REPO_PATH="/home/ysf/k8sfundamentals"

# Remote name to push to (leave empty to auto-select "all" if defined, else "origin"):
SYNCALIBUR_REMOTE=""

# Service / startup task name (change this if you run multiple instances):
SYNCALIBUR_SERVICE_NAME="syncalibur"

# How often to check for file changes (in seconds):
SYNCALIBUR_POLL_INTERVAL=3

# How long files must stay untouched before creating a commit (in seconds):
SYNCALIBUR_DEBOUNCE_WAIT=5

# Maximum wait time if files keep changing non-stop (in seconds):
SYNCALIBUR_MAX_DEBOUNCE=60

# Skip files larger than this size in MiB (0 disables the size limit):
SYNCALIBUR_MAX_FILE_SIZE_MB=50

# Space-separated filename globs that must never be auto-committed ("" disables):
SYNCALIBUR_SENSITIVE_PATTERNS="*.tfstate *.tfstate.* *.tfvars .env .env.* *.pem *.key *.p12 *.pfx id_rsa* id_ecdsa* id_ed25519* kubeconfig *.kubeconfig credentials.json"

# Initial and maximum retry delay when `git push` fails (in seconds):
SYNCALIBUR_RETRY_BASE=30
SYNCALIBUR_RETRY_MAX=900

# Timeout for a single `git push` command (in seconds):
SYNCALIBUR_PUSH_TIMEOUT=120

# Maximum log file size before automatic trimming (in KiB):
SYNCALIBUR_LOG_MAX_KB=1024
