# ==============================================================================
# Git Auto-Sync Configuration (git-auto-sync.env)
# ==============================================================================
# Enter the directory path you want to watch in AUTO_SYNC_REPO_PATH below,
# then run:
#   ./scripts/git-auto-sync.sh install
#
# Examples for all operating systems:
#   Linux   : AUTO_SYNC_REPO_PATH="/home/ysf/k8sfundamentals"
#   macOS   : AUTO_SYNC_REPO_PATH="/Users/username/projects/my-repo"
#   Windows : AUTO_SYNC_REPO_PATH="C:/Users/username/projects/my-repo"
#   Relative: AUTO_SYNC_REPO_PATH=".."   (watches the repo containing scripts/)
# ==============================================================================

# Path to the git repository (or a specific subfolder inside a repo) to watch:
AUTO_SYNC_REPO_PATH="/home/ysf/k8sfundamentals"

# Remote name to push to (leave empty to auto-select "all" if defined, else "origin"):
AUTO_SYNC_REMOTE=""

# Service / startup task name (change this if you run multiple instances):
AUTO_SYNC_SERVICE_NAME="git-auto-sync"

# How often to check for file changes (in seconds):
AUTO_SYNC_POLL_INTERVAL=3

# How long files must stay untouched before creating a commit (in seconds):
AUTO_SYNC_DEBOUNCE_WAIT=5

# Maximum wait time if files keep changing non-stop (in seconds):
AUTO_SYNC_MAX_DEBOUNCE=60

# Skip files larger than this size in MiB (0 disables the size limit):
AUTO_SYNC_MAX_FILE_SIZE_MB=50

# Space-separated filename globs that must never be auto-committed ("" disables):
AUTO_SYNC_SENSITIVE_PATTERNS="*.tfstate *.tfstate.* *.tfvars .env .env.* *.pem *.key *.p12 *.pfx id_rsa* id_ecdsa* id_ed25519* kubeconfig *.kubeconfig credentials.json"

# Initial and maximum retry delay when `git push` fails (in seconds):
AUTO_SYNC_RETRY_BASE=30
AUTO_SYNC_RETRY_MAX=900

# Timeout for a single `git push` command (in seconds):
AUTO_SYNC_PUSH_TIMEOUT=120

# Maximum log file size before automatic trimming (in KiB):
AUTO_SYNC_LOG_MAX_KB=1024
