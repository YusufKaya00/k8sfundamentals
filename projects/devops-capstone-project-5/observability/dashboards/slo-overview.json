{
  "id": null,
  "uid": "rs-slo-overview",
  "title": "🎯 ResilienceStream — 01. SLO Overview & Golden Signals",
  "description": "SLO ve Hata Bütçesi (Error Budget) Panosu: HTTP başarı oranı, p50/p95/p99 gecikme, sipariş sonuçları ve 5 bağımlılığın canlı durumu.",
  "tags": [
    "resiliencestream",
    "slo",
    "sre",
    "chaos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "🟢 5 Bağımlılık Canlı Sağlık Durumu (rs_dependency_up: 1=UP, 0=DOWN)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "min by (dependency) (rs_dependency_up{component=\"order-api\"} or rs_dependency_up)",
          "legendFormat": "{{ dependency }}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN ❌", "color": "red" },
                "1": { "text": "UP ✅", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "🛡️ HTTP Başarı Oranı SLO (Hedef >= %99)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "clamp_max(100 * (1 - ((sum(rate(rs_http_requests_total{status=~\"5..\"}[2m])) or vector(0)) / clamp_min(sum(rate(rs_http_requests_total[2m])), 0.0001))), 100)",
          "legendFormat": "Availability %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "🛒 Oluşturulan Siparişler (success / degraded / failed)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rs_orders_created_total)",
          "legendFormat": "{{ result }}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "⏱️ HTTP İstek Gecikmesi (Latency p50 / p95 / p99 — /api/orders & Genel)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rs_http_request_duration_seconds_bucket{endpoint=~\"/api/orders|/api/status\"}[2m]))) or vector(0)",
          "legendFormat": "p50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rs_http_request_duration_seconds_bucket{endpoint=~\"/api/orders|/api/status\"}[2m]))) or vector(0)",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rs_http_request_duration_seconds_bucket{endpoint=~\"/api/orders|/api/status\"}[2m]))) or vector(0)",
          "legendFormat": "p99 Latency (SLO < 1.0s)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 5,
      "title": "📈 Saniyedeki HTTP İstek Hızı (RPS — Endpoint & Status Bazlı)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (endpoint, status) (rate(rs_http_requests_total{endpoint!~\"/metrics\"}[2m]))",
          "legendFormat": "{{ endpoint }} [HTTP {{ status }}]"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 6,
      "title": "🔌 5 Bağımlılık Probe Gecikmesi (rs_dependency_latency_seconds p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(rs_dependency_latency_seconds_bucket[2m])))",
          "legendFormat": "{{ dependency }} p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ]
}
